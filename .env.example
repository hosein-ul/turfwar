# TURFWAR — Environment Configuration Template (.env.example)
# Copy to .env for local deployment. Never commit real secrets.

# Network Selection: testnet | mainnet | localnet
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_WALLET_URL=https://testnet.mynearwallet.com

# Core Game Smart Contract Account (Deploy target)
NEAR_CONTRACT_ID=turfwar.testnet

# Server-side Agent Funding Accounts (Testnet only)
GARRICK_ACCOUNT_ID=garrick.turfwar.testnet
GARRICK_PRIVATE_KEY=ed25519:...
SAFFRON_ACCOUNT_ID=saffron.turfwar.testnet
SAFFRON_PRIVATE_KEY=ed25519:...
VEX_ACCOUNT_ID=vex.turfwar.testnet
VEX_PRIVATE_KEY=ed25519:...

# Game Server Configuration
PORT=3001
VITE_API_URL=http://localhost:3001
WS_URL=ws://localhost:3001

# AI Agent LLM Provider (Optional fallback will run deterministically if empty)
GEMINI_API_KEY=
